{
  "name": "huishouden",
  "private": true,
  "version": "2.15.1",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3001",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "bun test src",
    "icons": "pwa-icons",
    "e2e": "playwright test e2e/smoke.spec.ts e2e/todo.spec.ts e2e/contact-import.spec.ts e2e/i18n.spec.ts",
    "e2e:signed-in": "playwright test e2e/signed-in.spec.ts e2e/my-calendar.spec.ts",
    "prepare": "git config core.hooksPath .githooks",
    "bootstrap": "node_modules/@huishouden/pwa-kit/infra/bootstrap.sh infra/apps.conf",
    "bootstrap:staging": "node_modules/@huishouden/pwa-kit/infra/bootstrap.sh --staging infra/apps.conf",
    "screenshots": "playwright test e2e/screenshots.spec.ts",
    "env:pull": "gh variable list --json name,value -q '.[] | select(.name|startswith(\"VITE_\")) | \"\\(.name)=\\(.value)\"' > .env.local && echo 'wrote .env.local'"
  },
  "devDependencies": {
    "@huishouden/pwa-kit": "github:huishouden/pwa-kit#v0.71.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "lucide-react": "^1.50.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
